# Publicly exposed URL for the backend API (Laravel API root, without trailing slash).
# Example: https://api.cnc.ao
NEXT_PUBLIC_API_URL=

# Public canonical website URL used for SEO and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://www.cnc.ao

# Optional comma-separated CDN/image hostnames returned by the API.
# Example: media.cnc.ao,images.example-cdn.com
NEXT_PUBLIC_IMAGE_DOMAINS=

# Optional Sanctum base URL if it is different from NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_SANCTUM_URL=

# Cookie name checked by middleware before rendering private CMS routes.
# Configure this to match the same-site session cookie issued for the website domain.
ADMIN_SESSION_COOKIE=cnc_admin_session
